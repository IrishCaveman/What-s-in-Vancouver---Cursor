  "description": "Vancouver event aggregator with tactile maximalist UI and ingestion guardrails.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "ingest": "tsx scripts/scrape-and-extract.ts",
